root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# The app tree mirrors the current main-branch prototype. Do not let editors
# rewrite its existing line endings or trailing whitespace implicitly.
[app/**]
insert_final_newline = unset
trim_trailing_whitespace = unset

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
