      "case_id": 6,
      "question": "26年Q1日均资产大于30万的客户，股票交易量大于10万的，其持有的产品属于哪些产品大类",
      "reference_sql": " \nWITH cust_avg_30 AS (\n    SELECT\n        pty_id,\n        ROUND(\n            SUM(\n                COALESCE(nm_tot_aset,0)\n                + COALESCE(fc_pur_aset,0)\n            ) / 90.0,\n            2\n        ) AS avg_aset\n    FROM dws_cust_aset_d\n    GROUP BY pty_id\n    HAVING\n        SUM(\n            COALESCE(nm_tot_aset,0)\n            + COALESCE(fc_pur_aset,0)\n        ) / 90.0 > 300000\n),\n\ncust_tran AS (\n    SELECT\n        b.pty_id,\n        SUM(\n            COALESCE(b.buy_amt,0)\n            + COALESCE(b.sell_amt,0)\n        ) AS tran_amt\n    FROM dwd_cust_tran_d b\n    INNER JOIN dim_product c\n        ON b.prdt_id = c.prdt_id\n       AND c.up_prdt_type_id = 'PT040000'\n    WHERE b.data_dt BETWEEN '20260101' AND '20260331'\n    GROUP BY b.pty_id\n    HAVING\n        SUM(\n            COALESCE(b.buy_amt,0)\n            + COALESCE(b.sell_amt,0)\n        ) > 100000\n)\n\nSELECT\n    c.up_prdt_type_name,\n    c.prdt_type_name,\n    SUM(b.mkt_val) AS mkt_val\nFROM cust_avg_30 x\nINNER JOIN cust_tran a\n    ON x.pty_id = a.pty_id\nINNER JOIN dwd_cust_hold_d b\n    ON a.pty_id = b.pty_id\n   AND b.data_dt = '20260331'\nINNER JOIN dim_product c\n    ON b.prdt_id = c.prdt_id\nGROUP BY\n    c.up_prdt_type_name,\n    c.prdt_type_name;\n",
      "generated_sql": "WITH target_customers AS\n  (SELECT a.pty_id\n   FROM dws_cust_aset_d a\n   WHERE a.data_dt BETWEEN '20260101' AND '20260331'\n   GROUP BY a.pty_id\n   HAVING SUM(COALESCE(a.nm_tot_aset, 0) + COALESCE(a.fc_pur_aset, 0)) *1.0 / 90 > 300000),\n     stock_traders AS\n  (SELECT t.pty_id\n   FROM dwd_cust_tran_d t\n   INNER JOIN dim_product p ON t.prdt_id = p.prdt_id\n   WHERE t.data_dt BETWEEN '20260101' AND '20260331'\n     AND p.up_prdt_type_name = '股票'\n   GROUP BY t.pty_id\n   HAVING SUM(COALESCE(t.buy_amt, 0) + COALESCE(t.sell_amt, 0)) > 100000),\n     qualified_customers AS\n  (SELECT tc.pty_id\n   FROM target_customers tc\n   WHERE EXISTS\n       (SELECT 1\n        FROM stock_traders st\n        WHERE tc.pty_id = st.pty_id)),\n     hold_agg AS\n  (SELECT h.pty_id,\n          p.up_prdt_type_name\n   FROM dwd_cust_hold_d h\n   INNER JOIN dim_product p ON h.prdt_id = p.prdt_id\n   WHERE h.data_dt = '20260331'\n   GROUP BY h.pty_id,\n            p.up_prdt_type_name)\nSELECT DISTINCT ha.up_prdt_type_name AS product_category\nFROM hold_agg ha\nWHERE EXISTS\n    (SELECT 1\n     FROM qualified_customers qc\n     WHERE ha.pty_id = qc.pty_id)",
